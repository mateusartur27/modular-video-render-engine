{
  "name": "modular-video-render-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Public render engine: consumes a RenderManifest@2 and produces an MP4. No channel rules, no credentials.",
  "main": "src/index.ts",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts Video out/video.mp4",
    "stage": "node scripts/stage-job.mjs",
    "verify": "node scripts/verify-output.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3",
    "vitest": "3.2.7"
  }
}
